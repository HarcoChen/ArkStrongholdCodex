{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ark-play",
  "version": "0.2.0-alpha.4",
  "description": "卫戍协议对局工具：单人、指定房间、紧凑局面与自动战斗结算。",
  "author": {
    "name": "HarcoChen",
    "url": "https://github.com/HarcoChen"
  },
  "homepage": "https://github.com/HarcoChen/ArkStrongholdCodex",
  "repository": "https://github.com/HarcoChen/ArkStrongholdCodex",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "arknights",
    "stronghold-protocol",
    "gameplay",
    "agent-tools"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "卫戍协议：盟约",
        "shortDescription": "开单人局，或加入房间与同伴协同布防",
        "longDescription": "在卫戍协议游戏站进行单人或同盟对局。默认站点 ark.minyako.top；可保存或临时指定房间号，加入后自动准备。模型读取紧凑局面并决策，插件自动处理战斗与结算，并声明 LLM · Codex 玩家来源。需要 Node.js 22+。记录、保存与鉴权由站点管理。",
        "developerName": "HarcoChen",
        "category": "Productivity",
        "capabilities": [
          "创建单人对局",
          "加入指定房间",
          "查看局面与执行动作",
          "查询公开卡牌资料",
          "自动战斗结算"
        ],
        "websiteURL": "https://github.com/HarcoChen/ArkStrongholdCodex",
        "supportURL": "https://github.com/HarcoChen/ArkStrongholdCodex/issues",
        "defaultPrompt": [
          "在 ark.minyako.top 开一局深渊，根据局面和公开说明决策，玩到自然结束。",
          "加入房间 AB12，准备后等待房主开始，再根据局面继续对局。",
          "把默认房间号设为 AB12，下次开局使用；保留已有站点和凭据配置。"
        ],
        "brandColor": "#4ed8af"
      }
    }
  }
}
